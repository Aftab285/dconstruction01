---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  ['01', 'Residential Construction', 'Custom homes and thoughtful additions crafted around the way you live.'],
  ['02', 'Commercial Construction', 'Workplaces and spaces built to perform, from shell to finish.'],
  ['03', 'Renovation & Remodeling', 'A smarter path to reimagining the spaces you already value.'],
  ['04', 'Project Management', 'Clear communication and disciplined execution at every stage.'],
];
const projects = [
  ['Harbor Residence', 'Residential · San Diego, CA', 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1400&q=85'],
  ['Mason Street Offices', 'Commercial · La Jolla, CA', 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1400&q=85'],
  ['North Park Renewal', 'Renovation · San Diego, CA', 'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1400&q=85'],
];
---
<Layout>
  <Header />
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=2400&q=90" alt="Modern building under construction" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-content container reveal">
        <p class="eyebrow light-eyebrow">Building with purpose</p>
        <h1 id="hero-title">Built to last.<br /><em>Designed</em> for what’s next.</h1>
        <p class="hero-copy">D Patel Construction delivers quality craftsmanship, dependable project management, and construction solutions built around your vision.</p>
        <div class="hero-actions"><a class="button gold" href="#contact">Request a quote <span>↗</span></a><a class="text-link light-link" href="#projects">View our projects <span>→</span></a></div>
      </div>
      <div class="hero-note"><span>Established</span><b>2009</b></div>
      <a href="#about" class="scroll-cue" aria-label="Scroll to content"><i></i> Scroll to explore</a>
    </section>

    <section id="about" class="about section container">
      <div class="about-image image-frame"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85" alt="Contemporary home exterior with stone and timber details" loading="lazy" /></div>
      <div class="about-copy">
        <p class="eyebrow">About D Patel Construction</p><h2>Quality construction.<br />Built around your vision.</h2>
        <p>From a first conversation to the final walk-through, we bring practical expertise, exacting standards, and a calm, collaborative approach to every project.</p>
        <p>Our team creates enduring residential and commercial spaces with the care, clarity, and accountability clients deserve.</p>
        <a class="text-link" href="#contact">More about our approach <span>→</span></a>
      </div>
      <aside class="about-stat"><strong>15<span>+</span></strong><small>Years of experience</small></aside>
    </section>

    <section id="services" class="services section">
      <div class="container"><div class="section-top"><div><p class="eyebrow">What we do</p><h2>Construction expertise<br />from concept to completion.</h2></div><p>We take on projects with the experience to see around corners—and the discipline to keep every detail on track.</p></div>
      <div class="service-grid">{services.map(([number, title, description]) => <article class="service-card"><span>{number}</span><h3>{title}</h3><p>{description}</p><a href="#contact" aria-label={`Learn more about ${title}`}>↗</a></article>)}</div></div>
    </section>

    <section id="projects" class="projects section container">
      <div class="section-top"><div><p class="eyebrow">Selected projects</p><h2>A closer look at the<br />work we’re proud to build.</h2></div><a class="text-link" href="#contact">View all projects <span>→</span></a></div>
      <div class="project-grid">{projects.map(([name, detail, image], index) => <a href="#contact" class:list={['project', { featured: index === 0 }]}><div class="project-image"><img src={image} alt={`${name} construction project`} loading="lazy" /></div><div class="project-info"><div><h3>{name}</h3><p>{detail}</p></div><span>↗</span></div></a>)}</div>
    </section>

    <section class="trust section"><div class="container trust-grid"><div><p class="eyebrow">Why D Patel</p><h2>Built on quality.<br />Driven by trust.</h2></div><div class="principles"><article><b>01</b><h3>Quality craftsmanship</h3><p>Work that stands up to close inspection, today and years from now.</p></article><article><b>02</b><h3>Clear accountability</h3><p>One committed team, transparent updates, and no loose ends.</p></article><article><b>03</b><h3>Detail-led delivery</h3><p>Planning and execution that protect what matters most to you.</p></article></div></div></section>

    <section class="process section container"><p class="eyebrow">Our process</p><h2>A better building experience,<br />from the ground up.</h2><div class="process-grid"><article><span>01</span><h3>Discover</h3><p>We listen closely to your vision, requirements, and priorities.</p></article><article><span>02</span><h3>Plan</h3><p>We shape a clear scope, schedule, and route to the right result.</p></article><article><span>03</span><h3>Build</h3><p>We bring the work to life with rigor, care, and regular communication.</p></article><article><span>04</span><h3>Deliver</h3><p>We finish strong and hand over a space made for what’s ahead.</p></article></div></section>

    <section id="contact" class="cta"><img src="https://images.unsplash.com/photo-1542621334-a254cf47733d?auto=format&fit=crop&w=2200&q=85" alt="Construction team discussing architectural plans" loading="lazy" /><div class="cta-shade"></div><div class="container cta-content"><p class="eyebrow light-eyebrow">Start a conversation</p><h2>Let’s build something<br /><em>great.</em></h2><p>Have a project in mind? Let’s talk about how D Patel Construction can bring it to life.</p><a class="button gold" href="mailto:hello@dpatelconstruction.com">Request a quote <span>↗</span></a></div></section>
  </main>
  <Footer />
</Layout>
